# Knobs for docker-compose.yml / convert.sh. Copy to `.env` and edit.
#   cp .env.example .env
# Anything here can also be overridden inline:
#   GPU=3 ITERATION=2400 ./convert.sh mg2hf

# ---- where the olala checkout is on the HOST (mounted at /work in the container) -----
OLALA_DIR=/data/home/gaetan.caillaut/olala-vllm/verl/olala

# ---- Megatron-LM + tokenizers ------------------------------------------------
# Mounted read-only at the same path inside the container, so the defaults
# baked into the scripts resolve unchanged.
DRAGON_SFT_DIR=/data/home/gaetan.caillaut/dragon-sft
MEGATRON_LM_DIR=/data/home/gaetan.caillaut/dragon-sft/7A1B/training/Megatron-LM
OLALA_TOKENIZER_DIR=/data/home/gaetan.caillaut/dragon-sft/7A1B/tokenizers/tokenizer-channels-v3

# ---- conversion image --------------------------------------------------------
CONVERT_IMAGE=git.corp.linguacustodia.com:5050/gcaillaut/olala-sft:convert-ckpt

# =============================================================================
# Megatron -> HF   (mg2hf, mg2hf-cpu)
# =============================================================================
# Host GPU id (appears as device 0 in the container). Ignored by mg2hf-cpu.
GPU=0

# Megatron checkpoint PARENT dir -- the one CONTAINING iter_XXXXXXX/.
# Megatron appends iter_{ITERATION:07d} itself; pointing this at the iter dir
# makes it look for iter_0099518/iter_0099518 and find nothing.
LOAD_DIR=/data/home/gaetan.caillaut/dragon-sft/7A1B/training/checkpoints/65k-betterpacks-lrfix/megatron

# HF output dir. mkdir -p it BEFORE running, or docker creates it root-owned.
SAVE_DIR=/data/home/gaetan.caillaut/dragon-sft/7A1B/training/checkpoints/65k-betterpacks-lrfix/huggingface/iter_0099518

# Iteration number matching LOAD_DIR
ITERATION=99518

# =============================================================================
# HF -> Megatron   (hf2mg)  -- CPU only by design; see docker-compose.yml
# =============================================================================
# HF checkpoint to read (e.g. what came back from post-training)
HF_DIR=/data/home/gaetan.caillaut/dragon-sft/7A1B/training/checkpoints/65k-betterpacks-lrfix/huggingface/iter_0099518

# REFERENCE Megatron checkpoint: parent dir + iteration. Required -- an HF
# export carries neither Megatron's `args` Namespace nor the padded vocab rows.
# A "near parent" is fine; every weight still comes from HF_DIR.
REF_MG_DIR=/data/home/gaetan.caillaut/dragon-sft/7A1B/training/checkpoints/65k-betterpacks-lrfix/megatron
REF_ITERATION=99518

# Megatron output dir + the iteration to stamp it with. mkdir -p it first.
# Load the result with --finetune (or --no-load-optim --no-load-rng): it has
# model weights only, so it starts a new run rather than resuming one.
MG_SAVE_DIR=/data/home/gaetan.caillaut/dragon-sft/7A1B/training/checkpoints/65k-betterpacks-lrfix/megatron-sft
MG_ITERATION=1
