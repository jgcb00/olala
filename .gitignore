*.pyc
__pycache__/
*.err
*.out

# Local launch/run scripts are not versioned, but the ones this repo ships are.
*.sh
!scripts/*.sh
!install/*.example.sh
!convert/convert.sh
# olala-env ships its builder, serve script, docker helpers and test recipes.
!olala-env/**/*.sh

# Machine-specific; convert/.env.example is the versioned template.
convert/.env
