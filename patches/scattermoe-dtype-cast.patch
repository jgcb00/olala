+        # set upstream and identical in both phases. No-op when dtypes agree.
+        weight = self.weight
+        if weight.dtype != inputs.dtype:
+            weight = weight.to(inputs.dtype)
+        if gates is not None and gates.dtype != inputs.dtype:
+            gates = gates.to(inputs.dtype)
 
